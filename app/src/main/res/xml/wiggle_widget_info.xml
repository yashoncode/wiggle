<?xml version="1.0" encoding="utf-8"?>
<!-- Three cells by three: the overview needs the height. Periodic refresh is a backstop;
     the app pushes an update whenever it writes something the widget shows. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="180dp"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_placeholder"
    android:previewLayout="@layout/widget_placeholder"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
