<?xml version="1.0" encoding="utf-8"?>
<!--
  What the launcher shows until the app has drawn the widget for the first time.

  Deliberately not a spinner: on phones that refuse to start an app in the background, the first
  draw waits for the app to be opened, and a spinner that never stops reads as a broken widget.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_placeholder_background"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#F4F4F5"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_placeholder"
        android:textColor="#9BA1AE"
        android:textSize="12sp" />
</LinearLayout>
