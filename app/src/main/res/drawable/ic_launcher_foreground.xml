<?xml version="1.0" encoding="utf-8"?>
<!--
  The Wiggle mark: an open ring around a dot, with two rising bars in the gap.

  Laid out inside the central 72x72 of the 108x108 adaptive viewport, so no launcher mask can
  clip a cap off. Round caps throughout, which is what gives the ring its ends.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ring: drawn as two half-arcs so the sweep flags stay readable. Open from 12 to 2 o'clock. -->
    <path
        android:pathData="M70.64,49.72 A17.57,17.57 0 0 1 43.39,69.35 A17.57,17.57 0 0 1 54.92,37.80"
        android:strokeColor="#FFF4F4F5"
        android:strokeWidth="5.25"
        android:strokeLineCap="round" />

    <!-- The dot the ring closes around. -->
    <path
        android:pathData="M54,55.35 m-5.5,0 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0 Z"
        android:fillColor="#FFF4F4F5" />

    <!-- Two bars in the gap: the shorter one first, so they read as a rising pair. -->
    <path
        android:pathData="M68.4,42.9 L68.4,39.2"
        android:strokeColor="#FFF4F4F5"
        android:strokeWidth="5.25"
        android:strokeLineCap="round" />
    <path
        android:pathData="M75.5,39.9 L75.5,32.5"
        android:strokeColor="#FFF4F4F5"
        android:strokeWidth="5.4"
        android:strokeLineCap="round" />
</vector>
